// LIL debugger projection — illustrative operator graph, not source.
// Exact raw token IDs await an admitted parallel/join ABI definition.

// Compact graph traversal mnemonic:
F[1,U,R<P,E>](?C(∥[AVATAR[0],PREFS[0]]))

// Expanded debugger view:
function (arg0: UserId) -> Result<Profile, LoadError> ![Net, DB.Read]
  propagate profile.combine(
    parallel.join(http.fetch_avatar(arg0), db.fetch_preferences(arg0)))

// `parallel.join` is explicit. The graph records child effects, join failure
// policy, cancellation, and ordering; it is never inferred from two branches.
